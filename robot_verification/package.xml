<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_verification</name>
  <version>0.1.0</version>
  <description>Pass/fail criteria of the bench verifications, evaluated on ros2 bag recordings.</description>
  <maintainer email="lucasfranciscovieira@gmail.com">Lucas Vieira</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
