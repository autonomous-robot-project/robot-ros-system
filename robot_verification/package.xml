<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_verification</name>
  <version>0.1.0</version>
  <description>Bench checks and measurements: the link check, the link load and the pass/fail criteria of the verifications on ros2 bags.</description>
  <maintainer email="lucasfranciscovieira@gmail.com">Lucas Vieira</maintainer>
  <license>Proprietary</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
